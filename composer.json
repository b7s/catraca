{
    "name": "b7s/catraca",
    "description": "PHP Quality Guardian — enforces the Catraca (ratchet) principle: quality metrics can only improve, never regress",
    "type": "library",
    "keywords": ["quality", "catraca", "ratchet", "babysit", "git-action", "ci", "static-analysis", "coverage", "duplication", "grumphp"],
    "license": "MIT",
    "authors": [
        {
            "name": "Bruno Souza",
            "email": "me@brunots.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/b7s/catraca/issues",
        "source": "https://github.com/b7s/catraca"
    },
    "require": {
        "php": "^8.3",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "laravel/pint": "^1.29",
        "phpmetrics/phpmetrics": "^2.9",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "systemsdk/phpcpd": "^8.0 || ^9.0"
    },
    "bin": [
        "bin/catraca"
    ],
    "autoload": {
        "psr-4": {
            "B7S\\Catraca\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "B7S\\Catraca\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
