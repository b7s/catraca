#!/usr/bin/env php
<?php

use B7S\Catraca\Command\CheckCommand;
use B7S\Catraca\Command\InitCommand;
use Symfony\Component\Console\Application;

require __DIR__ . '/../vendor/autoload.php';

$application = new Application('catraca', '1.0.0');
$application->addCommands([
    new InitCommand(),
    new CheckCommand(),
]);
$application->setDefaultCommand('check', false);
$application->run();
