{
    "name": "b7s/ratchet-babysit",
    "description": "PHP Quality Guardian — enforces the Ratchet principle: quality metrics can only improve, never regress",
    "type": "library",
    "keywords": ["quality", "ratchet", "babysit", "ci", "static-analysis", "coverage", "duplication", "grumphp"],
    "license": "MIT",
    "authors": [
        {
            "name": "B7S"
        }
    ],
    "support": {
        "issues": "https://github.com/b7s/ratchet-babysit-php/issues",
        "source": "https://github.com/b7s/ratchet-babysit-php"
    },
    "require": {
        "php": "^8.2",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "bin": [
        "bin/ratchet-babysit"
    ],
    "autoload": {
        "psr-4": {
            "B7S\\RatchetBabysit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "B7S\\RatchetBabysit\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
